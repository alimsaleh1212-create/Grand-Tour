# =============================================================================
# Smart Travel Planner — Environment Variables (template)
# Copy to `.env` and fill in real values. Never commit `.env`.
# Variables are validated at app startup via backend/app/core/settings.py.
# =============================================================================

# ---------- Application ----------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
CORS_ORIGINS=http://localhost:5173  # comma-separated list

# ---------- Postgres + pgvector ----------
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=vectordb
POSTGRES_HOST=db                    # docker service name
POSTGRES_PORT=5432

# ---------- JWT / Auth ----------
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
BCRYPT_ROUNDS=12

# ---------- LLM (Google Gemini) ----------
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_CHEAP_MODEL=gemini-2.5-flash
GEMINI_STRONG_MODEL=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# ---------- Embeddings (Gemini API) ----------
# Uses the same GOOGLE_API_KEY as the LLM above — no extra key needed.
# text-embedding-004 produces 768-dim vectors; must match the pgvector column.
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# ---------- ML Model ----------
ML_MODEL_PATH=../ml/models/travel_style_classifier_v1.joblib

# ---------- RAG / Chunking ----------
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ---------- Live conditions APIs ----------
# Open-Meteo (weather)   — no key required
# exchangerate.host (FX) — no key required

# ---------- LangSmith (tracing, optional) ----------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Ground_Travel"

# ---------- pgAdmin (development UI, optional) ----------
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ---------- Webhook (default channel) ----------
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=1

# ---------- HashiCorp Vault (dev only) ----------
# Non-secrets: connection coordinates for the local dev Vault container.
# In production, inject VAULT_ADDR via the deploy platform and use a
# scoped AppRole token instead of the dev root token.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
